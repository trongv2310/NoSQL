# Cổng API
PORT=4000
# Địa chỉ frontend Next.js (CORS, URL trả về của MoMo)
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/shop_caulong

# JWT (đổi thành chuỗi ngẫu nhiên dài khi triển khai thật)
JWT_SECRET=doi-secret-nay-trong-moi-truong-that
# Đặt false nếu chạy production nhưng chưa có HTTPS
COOKIE_SECURE=true

# Thư mục lưu ảnh upload (mặc định ./uploads)
# UPLOAD_DIR=./uploads

# ---- Google Gemini (AI Chatbot) – lấy key tại https://aistudio.google.com/apikey ----
# Để trống: chatbot vẫn chạy, trả lời bằng dữ liệu tra cứu trong kho
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

